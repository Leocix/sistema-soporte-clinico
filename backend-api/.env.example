# Copiar como .env y completar. NUNCA versionar el archivo .env real (RNF01).
ENVIRONMENT=local

# PostgreSQL gestionado (Aiven). Conexion cifrada en transito.
# DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@HOST:PUERTO/BASE?sslmode=require
DATABASE_URL=sqlite:///./cdss_adherencia.db

# Clave de firma JWT: generar con  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes autorizados del panel medico (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*vercel\.app$

# Hosts confiables en produccion (usar * solo en local).
ALLOWED_HOSTS=*

# --- Restablecimiento de contrasena por correo (RF10) ---
# Donde vive el panel web: es el destino del enlace que recibe el usuario.
FRONTEND_URL=http://localhost:5173
MINUTOS_VIGENCIA_RESTABLECIMIENTO=30

# Servidor de correo saliente. Dejar SMTP_HOST vacio desactiva la funcion:
# el API responde que hay que solicitar el restablecimiento en el consultorio.
# Puerto 465 para TLS directo; 587 para STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# Microservicio de inferencia
MODEL_PATH=../ml-pipeline/models/risk_model_v1.pkl
UMBRAL_RIESGO_ALTO=0.70
