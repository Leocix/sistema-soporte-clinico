ml-pipeline/models/*.pkl
# El modelo en servicio y su ficha si se versionan: Render los necesita para
# poder responder predicciones, y la ficha declara con que datos se entreno.
!ml-pipeline/models/risk_model_v1.pkl
!ml-pipeline/models/risk_model_v1.json
node_modules/
dist/
.vercel

# El APK se regenera con `flutter build apk --release`; no se versiona.
app-movil/entregable/
# Copia local del APK que sirve la página /descargar del panel.
frontend-web/public/descargas/

