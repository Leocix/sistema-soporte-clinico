# URL del API Gateway. En local apunta al servidor de desarrollo de FastAPI;
# en Vercel se configura con el dominio del servicio desplegado en Render.
VITE_API_URL=http://127.0.0.1:8000

# Dirección del APK de «Mi tratamiento» que ofrece la página /descargar.
# Sin valor se usa /descargas/mi-tratamiento.apk, que deja ahí
# `python iniciar_local.py apk`. En Vercel, la URL del APK publicado.
# VITE_APK_URL=https://github.com/<usuario>/<repositorio>/releases/latest/download/mi-tratamiento.apk

# Correo de contacto que citan la Política de privacidad y los Términos.
# VITE_CORREO_CONTACTO=soporte@consultorio.pe
